{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true, "skipLibCheck": true, "noEmitOnError": true,
    "rootDir": "src", "outDir": "dist", "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
