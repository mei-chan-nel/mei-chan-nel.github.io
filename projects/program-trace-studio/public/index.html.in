<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="%%ROBOTS%%">
  <title>プログラムトレース Studio｜情報Ⅰ Study Atlas</title>
  <meta name="description" content="共通テスト「情報Ⅰ」のプログラム表記で自分のプログラムを書き、1行ずつ実行。変数や配列の変化を確かめ、ブラウザに保存したりURLで共有できます。">
  <link rel="alternate" type="application/schema+json" href="./ai-guide.json" title="Program Trace Studio file schema for AI">
  <link rel="help" type="text/markdown" href="./ai-guide.md" title="Program Trace Studio instructions for AI">
  <!-- AI authoring contract (not part of the visible editor):
       Read ai-guide.md and ai-guide.json before generating an import file.
       Emit a UTF-8 JSON object: {"format":"mei-program-studio","version":1,
       "title":"...","source":"...","settings":{"indexBase":0,"inputs":{}}}.
       source is Information I pseudocode, not JavaScript. Use two-space indentation
       or correct ｜ / ⎿ markers; no end keywords. Put custom definitions in the same
       source, at the outermost level: 定義する name(args)： with an indented body.
       返す value returns a value; bare 返す ends a standalone call without a value.
       Pass local values as arguments. Recursion requires a terminating condition;
       at most 32 calls deep and 10000 execution steps. Keep document version 1.
       Supported built-ins: 表示する(...), 要素数(array), 乱数(), 乱数(min,max,"整数"|"実数").
       Initialize 1D/rectangular 2D arrays before writing elements. Set every external
       input's bounds and type in settings.inputs. Generate complete source only;
       omit builder (reserved for the app's unfinished editor drafts).
       Never put HTML, eval, imports, or instructions to the user in the program.
  -->
  <link rel="canonical" href="%%CANONICAL%%">
  <meta property="og:type" content="website">
  <meta property="og:title" content="プログラムトレース Studio｜情報Ⅰ Study Atlas">
  <meta property="og:description" content="自分のプログラムを書いて、1行ずつ動きを確かめよう。">
  <meta property="og:url" content="%%CANONICAL%%">
  <meta property="og:image" content="https://mei-chan-nel.com/assets/og-study-atlas.png">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" type="image/svg+xml" href="../icon.svg">
  <link rel="stylesheet" href="../../assets/site.css?v=2026100303">
  <link rel="stylesheet" href="./trace-base.css?v=20261009-function-help3">
  <link rel="stylesheet" href="./studio.css?v=20261009-function-help3">
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6257644709224446" crossorigin="anonymous"></script>
  <script src="../../assets/manual-ads.js?v=2026080901" defer></script>
  <script type="module" src="./app.js?v=20261009-flowchart1"></script>
  <script type="application/ld+json">[{"@context":"https://schema.org","@type":"SoftwareApplication","name":"プログラムトレース Studio","url":"%%CANONICAL%%","applicationCategory":"EducationalApplication","operatingSystem":"Web browser","offers":{"@type":"Offer","price":"0","priceCurrency":"JPY"}},{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"情報Ⅰ Study Atlas","item":"https://mei-chan-nel.com/"},{"@type":"ListItem","position":2,"name":"プログラムトレース","item":"https://mei-chan-nel.com/program-trace/"},{"@type":"ListItem","position":3,"name":"Studio","item":"%%CANONICAL%%"}]}]</script>
</head>
<body class="studio-page" data-studio-entry="%%ENTRY%%">
<a class="skip-link" href="#main-content">本文へスキップ</a>
<!--site-header-->
<script src="../../assets/site-header.js?v=2026100501" defer></script>
<main id="main-content" class="trace-shell">
  <nav class="breadcrumb" aria-label="パンくずリスト"><a href="../../">Study Atlas</a><span aria-hidden="true">/</span><a href="../">プログラムトレース</a><span aria-hidden="true">/</span><span>Studio</span></nav>
  <div class="studio-heading">
    <div><p class="eyebrow">プログラムトレース Studio</p><h1 id="studio-title" tabindex="-1">プログラムを、<em>書いて動かす。</em></h1></div>
    <button id="to-editor" class="button" type="button" hidden>プログラムを編集</button>
  </div>
  <p id="notice" class="studio-notice" role="status" hidden></p>
  <button id="recover-draft" class="button recovery-button" type="button" hidden>移行前の下書きをファイルに書出</button>
  <noscript><p class="error-message">Studioを使うには、ブラウザのJavaScriptを有効にしてください。</p></noscript>
  <section id="editor-view" class="workspace-grid studio-editor-layout" aria-label="プログラムを作成する">
    <div class="editor-main panel">
      <div class="editor-title-field"><label for="program-name">プログラム名</label><input id="program-name" type="text" maxlength="120" autocomplete="off" value=""></div>
      <div class="panel-heading builder-program-heading"><h2>プログラム</h2><span id="source-size" class="subtle-label"></span><button id="builder-first-plus" class="builder-plus" type="button" aria-label="1行目の上に行を追加">＋</button></div>
      <div id="builder-programs"><ol id="builder-rows" class="program-lines builder-rows" aria-label="メインプログラムの処理"></ol><div id="builder-function-blocks"></div></div>
      <p id="drag-status" class="drag-status" role="status"></p>
      <pre id="builder-source" hidden></pre>
      <p id="editor-error" class="error-message" role="alert" hidden></p>
    </div>
    <aside class="editor-sidebar" aria-label="編集の操作">
      <div class="panel editor-document-panel">
        <div id="editor-document-tools">
          <div id="document-tools" class="document-toolbar" aria-label="プログラムの保存と共有">
            <div class="document-actions"><button id="new-program" class="button" type="button">新規作成</button><button id="share-button" class="button button-auto" type="button">URLで共有 <span aria-hidden="true">↗</span></button><button id="load-button" class="button" type="button">ブラウザ内から読込</button><button id="save-button" class="button" type="button">ブラウザ内に保存</button><button id="import-button" class="button" type="button">ファイルから読込</button><button id="export-button" class="button" type="button">ファイルに書出</button></div>
            <button id="flowchart-button" class="button" type="button">フローチャートに変換</button>
            <span id="draft-status" class="subtle-label" role="status"></span>
            <input id="file-input" type="file" accept=".json,application/json" hidden>
          </div>
        </div>
        <div class="editor-run-action"><button id="prepare-button" class="button button-primary" type="button">実行画面へ <span aria-hidden="true">→</span></button></div>
      </div>
      <div class="panel editor-edit-panel">
        <div class="builder-history"><button id="builder-undo" class="button" type="button" disabled>元に戻す</button><button id="builder-redo" class="button" type="button" disabled>やり直す</button></div>
        <div class="builder-index"><label for="index-base">配列の番号：</label><select id="index-base"><option value="0">0から始める</option><option value="1">1から始める</option></select></div>
      </div>
      <!--studio-file-spec-->
    </aside>
  </section>
  <section id="runner-view" aria-label="プログラムを実行する" hidden>
    <div id="runner-document-tools"></div>
    <div class="control-panel"><div class="action-buttons">
      <button id="previous-button" class="button" type="button" disabled><span class="button-icon" aria-hidden="true">←</span>前へ</button>
      <button id="next-button" class="button button-primary" type="button"><span class="button-icon" aria-hidden="true">→</span>次へ</button>
      <button id="reset-button" class="button" type="button"><span aria-hidden="true">↺</span>最初から</button>
      <button id="edit-values-button" class="button button-edit" type="button"><span aria-hidden="true">◇</span>値を変更する</button>
      <button id="play-button" class="button button-auto" type="button" aria-pressed="false"><span id="play-icon" aria-hidden="true">▶</span><span id="play-label">自動実行</span></button>
      <div class="speed-control"><button id="speed-button" class="button speed-button" type="button" aria-expanded="false" aria-controls="speed-panel">実行速度 <span id="speed-value">0.5秒</span><span aria-hidden="true">⌄</span></button><div id="speed-panel" class="speed-panel" role="group" aria-label="実行速度の設定" hidden><p class="speed-title">1ステップの間隔</p><div class="speed-adjustment"><button id="speed-decrease" class="button speed-adjust-button" type="button" aria-label="実行を速くする">−</button><label class="speed-input-wrap"><input id="speed-input" type="number" min="0.001" max="10" step="any" value="0.5" aria-label="1ステップの秒数"><span>秒</span></label><button id="speed-increase" class="button speed-adjust-button" type="button" aria-label="実行を遅くする">＋</button></div><p id="speed-error" class="speed-error" role="alert" hidden></p></div></div>
      <button id="fullscreen-button" class="button fullscreen-button" type="button" aria-expanded="false" aria-controls="fullscreen-surface"><span aria-hidden="true">⛶</span>全画面</button>
    </div></div>
    <div class="execution-status"><p><span id="status-dot" class="status-dot" aria-hidden="true"></span><strong id="status-text">実行前</strong><span id="current-line-label"></span></p><div><span id="step-count">0 ステップ</span><span class="keyboard-hint" title="長押しで連続実行"><kbd>Space</kbd> / <kbd>Enter</kbd>で次へ</span></div></div>
    <div id="workspace" class="workspace-grid studio-workspace">
      <section class="program-panel panel" aria-labelledby="program-heading"><div class="panel-heading"><h2 id="program-heading">プログラム</h2></div><ol id="program-lines" class="program-lines" aria-label="行番号付きプログラム"></ol></section>
      <div class="result-column">
        <section class="explanation-panel panel" aria-labelledby="explanation-heading"><div class="panel-heading"><h2 id="explanation-heading"><button class="panel-toggle" type="button" aria-expanded="true" aria-controls="explanation-body" disabled>解説<span class="panel-chevron" aria-hidden="true">▾</span></button></h2><button id="explanation-full" class="text-button" type="button" hidden>全文を見る</button></div><div id="explanation-body" class="panel-body"><div id="step-detail" class="step-detail"><p id="detail-label" class="detail-label">実行前</p><h3 id="detail-title">「次へ」で1行目から実行</h3><p id="detail-explanation">実行中の行と、変数の変化を確かめましょう。</p><div id="condition-result" class="condition-result" hidden></div></div></div></section>
        <section class="variables-panel panel" aria-labelledby="variables-heading"><div class="panel-heading"><h2 id="variables-heading"><button class="panel-toggle" type="button" aria-expanded="true" aria-controls="variables-body" disabled>変数の値<span class="panel-chevron" aria-hidden="true">▾</span></button></h2><button id="variables-full" class="text-button" type="button">すべて見る</button></div><p id="function-scope" class="function-scope" hidden></p><div id="variables-body" class="panel-body"><div id="variable-table" class="variable-table" role="table" aria-label="現在の変数と変更前後の値"><div id="variable-rows" class="variable-rows studio-variable-rows" role="rowgroup"></div></div></div></section>
        <section class="output-panel panel" aria-labelledby="output-heading"><div class="panel-heading"><h2 id="output-heading"><button class="panel-toggle" type="button" aria-expanded="true" aria-controls="output-body" disabled>出力<span class="panel-chevron" aria-hidden="true">▾</span></button></h2><div class="output-heading-actions"><span id="output-count" class="output-count">0件</span><button id="output-full" class="text-button" type="button" disabled>すべて見る</button></div></div><div id="output-body" class="panel-body"><p id="output-placeholder" class="output-placeholder">表示する()を実行すると、ここに表示されます。</p><ol id="output-lines" class="output-lines" role="log" aria-label="プログラムの出力"></ol></div></section>
      </div>
    </div>
    <section id="fullscreen-surface" class="fullscreen-surface" aria-label="全画面でプログラムを実行" hidden>
      <nav class="fullscreen-sidebar" aria-label="全画面の操作">
        <button class="fullscreen-action fullscreen-exit" type="button" data-fullscreen-exit aria-label="全画面を終了して元の画面へ" title="全画面を終了して元の画面へ">×</button>
        <button class="fullscreen-action" type="button" data-control="previous" aria-label="前へ" title="前へ">←</button>
        <button class="fullscreen-action fullscreen-next" type="button" data-control="next" aria-label="次へ" title="次へ">→</button>
        <button class="fullscreen-action" type="button" data-control="reset" aria-label="最初から" title="最初から">↻</button>
        <button class="fullscreen-action" type="button" data-control="edit" aria-label="値を変更する" title="値を変更する">✎</button>
        <button class="fullscreen-action" type="button" data-control="play" aria-label="自動実行" aria-pressed="false" title="自動実行">▶</button>
        <button class="fullscreen-action" type="button" data-control="speed" aria-label="実行速度" aria-expanded="false" aria-controls="speed-panel" title="実行速度">⚙</button>
      </nav>
      <div id="fullscreen-workspace" class="fullscreen-workspace"></div>
    </section>
    <p id="run-error" class="error-message" role="alert" hidden></p>
    <div id="completion-message" class="completion-message" hidden><span aria-hidden="true">✓</span><strong>実行が終わりました。</strong><span class="completion-copy">「最初から」で実行し直せます。</span></div>
  </section>
  <span id="execution-announcement" class="sr-only" role="status" aria-live="polite"></span>
</main>
<div class="manual-ad-slot manual-ad-slot--display" data-manual-ad="display" data-ad-placement="after-program-studio-main" hidden></div>
<!--site-footer-->
<dialog id="save-dialog" aria-labelledby="save-heading"><form id="save-form"><div class="dialog-heading"><h2 id="save-heading">名前をつけて保存</h2><button type="button" class="close-button" data-close-dialog aria-label="閉じる">×</button></div><p class="dialog-description">このブラウザに保存します。</p><div class="parameter-field"><label for="save-name">プログラム名</label><input id="save-name" maxlength="120" required></div><p class="form-error" role="alert" hidden></p><div class="dialog-actions"><button id="save-copy" type="button" class="button">別の名前で保存</button><button id="save-submit" class="button button-primary" type="submit">保存する</button></div></form></dialog>
<dialog id="new-dialog" aria-labelledby="new-heading"><div class="dialog-content"><div class="dialog-heading"><h2 id="new-heading">現在のプログラムは未保存です</h2><button type="button" class="close-button" data-close-dialog aria-label="閉じる">×</button></div><p class="dialog-description">変更した内容を保存してから、新しいプログラムを作りますか。</p><p class="form-error" role="alert" hidden></p><div class="dialog-actions"><button type="button" class="button" data-close-dialog>キャンセル</button><div><button id="new-discard" type="button" class="button">保存しない</button><button id="new-save" type="button" class="button button-primary">保存する</button></div></div></div></dialog>
<dialog id="export-dialog" aria-labelledby="export-heading"><form id="export-form" novalidate><div class="dialog-heading"><h2 id="export-heading">ファイルに書出</h2><button type="button" class="close-button" data-close-dialog aria-label="閉じる">×</button></div><div class="parameter-field"><label for="export-name">ファイル名</label><input id="export-name" type="text" maxlength="160" autocomplete="off" required></div><p class="form-error" role="alert" hidden></p><div class="dialog-actions"><button type="button" class="button" data-close-dialog>キャンセル</button><button type="submit" class="button button-primary">書き出す</button></div></form></dialog>
<dialog id="load-dialog" aria-labelledby="load-heading"><div class="dialog-content"><div class="dialog-heading"><h2 id="load-heading">保存したプログラム</h2><button type="button" class="close-button" data-close-dialog aria-label="閉じる">×</button></div><div id="saved-list" class="saved-list"></div></div></dialog>
<dialog id="confirm-dialog" aria-labelledby="confirm-heading"><form id="confirm-form"><div class="dialog-heading"><h2 id="confirm-heading">プログラムを読み込む</h2><button type="button" class="close-button" data-close-dialog aria-label="閉じる">×</button></div><p id="confirm-copy" class="dialog-description"></p><p class="dialog-description">現在のプログラムは置き換わります。残したい場合は先に保存してください。</p><div class="dialog-actions"><button type="button" class="button" data-close-dialog>キャンセル</button><button type="submit" class="button button-primary">読み込む</button></div></form></dialog>
<dialog id="share-dialog" aria-labelledby="share-heading"><div class="dialog-content"><div class="dialog-heading"><h2 id="share-heading">URLで共有</h2><button type="button" class="close-button" data-close-dialog aria-label="閉じる">×</button></div><p class="dialog-description">このURLにプログラムと設定が含まれます。受け取った人が編集しても、あなたの保存には影響しません。</p><label class="share-label" for="share-url">共有URL</label><textarea id="share-url" class="share-url" readonly rows="3"></textarea><p id="share-status" class="field-help" role="status"></p><p id="share-error" class="form-error" role="alert" hidden></p><div class="dialog-actions"><button id="share-export" type="button" class="button">ファイルに書き出す</button><div><button id="native-share" type="button" class="button" hidden>共有する</button><button id="copy-url" type="button" class="button button-primary">URLをコピー</button></div></div></div></dialog>
<dialog id="values-dialog" aria-labelledby="values-heading"><form id="values-form"><div class="dialog-heading"><h2 id="values-heading">値を変更する</h2><button type="button" class="close-button" data-close-dialog aria-label="閉じる">×</button></div><p class="dialog-description">初期値や繰り返しの範囲を変更して、最初から実行します。</p><div id="value-fields" class="parameter-fields"></div><p class="form-error" role="alert" hidden></p><div class="dialog-actions"><button type="button" class="button" data-close-dialog>キャンセル</button><button type="submit" class="button button-primary">変更して最初から</button></div></form></dialog>
<dialog id="input-dialog" aria-labelledby="input-heading"><form id="input-form"><div class="dialog-heading"><h2 id="input-heading" tabindex="-1">外部からの入力</h2><button type="button" class="close-button" data-close-dialog aria-label="閉じる">×</button></div><p id="input-description" class="dialog-description"></p><div id="input-fields" class="parameter-fields"></div><p class="form-error" role="alert" hidden></p><div class="dialog-actions"><button type="button" class="button" data-close-dialog>キャンセル</button><button type="submit" class="button button-primary">入力して実行</button></div></form></dialog>
<dialog id="inspect-dialog" class="inspect-dialog" aria-labelledby="inspect-heading"><div class="dialog-content"><div class="dialog-heading"><h2 id="inspect-heading">変数の値</h2><button type="button" class="close-button" data-close-dialog aria-label="閉じる">×</button></div><div id="inspect-content" class="inspector-content"></div></div></dialog>
<dialog id="row-dialog" class="row-dialog" aria-labelledby="row-heading"><form id="row-form" novalidate><div class="dialog-heading"><h2 id="row-heading">行を設定する</h2><button type="button" class="close-button" data-close-dialog aria-label="閉じる">×</button></div><div id="row-fields"></div><p class="form-error" role="alert" hidden></p><div class="dialog-actions row-dialog-footer"><div id="row-actions" class="row-edit-actions"></div><div class="row-confirm-actions"><button type="button" class="button" data-close-dialog>キャンセル</button><button id="row-submit" type="submit" class="button button-primary">この行に反映</button></div></div></form></dialog>
</body>
</html>
