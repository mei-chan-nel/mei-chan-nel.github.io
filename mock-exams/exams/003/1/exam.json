      ]
    },
    {
      "id": "q4-エ",
      "sectionId": "q4",
      "label": "エ",
      "type": "choice",
      "choices": [
        {
          "value": "0",
          "text": "提供回数をそろえても全体の平均は下がるので，回数の違いだけでは低下を説明できず，19種類全ての献立で食べ残しが減っている"
        },
        {
          "value": "1",
          "text": "食べ残しが増えた献立もあるので，提供回数をそろえて全体の平均が下がっても，その低下は回数の違いだけで説明できる"
        },
        {
          "value": "2",
          "text": "献立別の平均を使っても，実施前の記録は献立によって4〜6日分と違うので，比較用の平均には提供回数の違いがそのまま残る"
        },
        {
          "value": "3",
          "text": "提供回数をそろえても全体の平均は下がるので，回数の違いだけでは低下を説明できないが，食べ残しが減った献立ばかりではない"
        }
      ]
    },
    {
      "id": "q4-オ",
      "sectionId": "q4",
      "label": "オ",
      "type": "choice",
      "choices": [
        {
          "value": "0",
          "text": "小さくなる。食べ残しの平均に加えた1日の値が，残る134日の平均より小さいためである"
        },
        {
          "value": "1",
          "text": "大きくなる。厨房・配膳の記録は同じで，食べ残しの記録を1日分多く使うためである"
        },
        {
          "value": "2",
          "text": "同じになる。二つの量の平均を足せば，合計の平均になるためである"
        },
        {
          "value": "3",
          "text": "大小は決められない。記録がない日の厨房・配膳の廃棄量が分からないためである"
        }
      ]
    },
    {
      "id": "q4-カ",
      "sectionId": "q4",
      "label": "カ",
      "type": "choice",
      "choices": [
        {
          "value": "0",
          "text": "食べ残しの減少量はPの方が大きく，廃棄全体ではPとRのどちらも減少している"
        },
        {
          "value": "1",
          "text": "食べ残しの減少量はRの方が大きく，廃棄全体ではPとRのどちらも減少している"
        },
        {
          "value": "2",
          "text": "食べ残しの減少量はRの方が大きいが，廃棄全体ではPは減少し，Rは増加している"
        },
        {
          "value": "3",
          "text": "食べ残しの減少量はPの方が大きいが，廃棄全体ではPは減少し，Rは増加している"
        }
      ]
    },
    {
      "id": "q4-キ",
      "sectionId": "q4",
      "label": "キ",
      "type": "choice",
      "choices": [
        {
          "value": "0",
          "text": "各献立の廃棄全体が増えたか減ったかという判断は変わらない。同じ点の座標の和を正の値で割って100を掛けても，正負は変わらないためである"
        },
        {
          "value": "1",
          "text": "各献立の二つの座標の和は，数値が変わらない。一つの点の横座標と縦座標を，同じ基準量で割るためである"
        },
        {
          "value": "2",
          "text": "献立どうしで横座標を比べたときの大小は変わらない。どの献立も，横座標を正の基準量で割るためである"
        },
        {
          "value": "3",
          "text": "献立どうしで二つの座標の和を比べたときの大小は変わらない。一つの点の横座標と縦座標を，同じ基準量で割るためである"
        }
      ]
    },
    {
      "id": "q4-ク",
      "sectionId": "q4",
      "label": "ク",
      "type": "choice",
      "choices": [
        {
          "value": "0",
          "text": "減少量も減少率もSの方が大きい。SはTより基準量が大きいので，減少率も大きくなるためである"
        },
        {
          "value": "1",
          "text": "減少量はTの方が大きく，減少率はSの方が大きい。SはTより基準量が小さく，二つの献立で割る値が異なるためである"
        },
        {
          "value": "2",
          "text": "減少量はSの方が大きく，減少率はTの方が大きい。SはTより基準量が大きく，二つの献立で割る値が異なるためである"
        },
        {
          "value": "3",
          "text": "減少量も減少率もTの方が大きい。TはSより基準量が小さいので，変換前の減少量も大きくなるためである"
        }
      ]
    },
    {
      "id": "q4-ケ",
      "sectionId": "q4",
      "label": "ケ",
      "type": "choice",
      "choices": [
        {
          "value": "0",
          "text": "実施後の記録は各献立1日分なので，実施前も各献立の記録を1日分だけ残して比べれば，日によるばらつきの影響を小さくできる。"
        },
        {
          "value": "1",
          "text": "献立Rで廃棄が出る過程を調べるため，同じ献立の日を増やし，調理した量，盛り付けた量，実際に食べた量も同じ日に記録する。"
        },
        {
          "value": "2",
          "text": "図4は各献立の実施前の廃棄量を基準にしているので，二つの座標の和を比べれば，実施後の1人当たりの廃棄量の平均が大きい献立を特定できる。"
        },
        {
          "value": "3",
          "text": "期間中の食べ残しの総量は，日ごとに求めた1人当たりの量を単純平均し，期間中の利用人数の合計を掛ければ正確に求められる。"
        },
        {
          "value": "4",
          "text": "19種類を各1回提供する場合は，前後それぞれで各献立の1人当たりの平均廃棄量を足し，その和から全体の変化率を求める。献立別の変化率は単純平均しない。"
        }
      ]
    },
